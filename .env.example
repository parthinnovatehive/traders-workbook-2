# =============================================================================
# Trader's Workbook — environment variables
# Copy to `.env.local` and fill in. Only VITE_-prefixed vars reach the client.
# NEVER put service-role keys or secrets in a VITE_ variable — they are public.
# =============================================================================

# Data source for the app.
#   "local"    — in-browser mock repository (localStorage). DEVELOPMENT ONLY:
#                it ships demo credentials and fake data, so a production build
#                refuses to start with it (see src/services/index.ts).
#   "supabase" — the real backend. Set the two variables below and run the
#                migrations in supabase/migrations/ in order (0001 → 0003).
VITE_DATA_SOURCE=local

# Base URL of an optional custom API (reserved for future use).
VITE_API_URL=

# --- SEO / canonical origin --------------------------------------------------
# The origin used for canonical URLs, <meta property="og:url">, robots.txt and
# sitemap.xml. LEAVE THIS BLANK IN PRODUCTION: blank correctly resolves to
# https://tradersworkbook.com
#
# Set it ONLY to point a build at a different host, e.g. a staging deploy:
#   VITE_SITE_URL=https://staging.tradersworkbook.com
#
# Getting this wrong is worse than leaving it blank — a staging build that keeps
# the production origin tells Google the staging copy is the real site, and a
# production build pointed at staging tells it the opposite.
VITE_SITE_URL=

# --- Supabase backend (when VITE_DATA_SOURCE=supabase) -----------------------
# The anon key is safe to expose to the browser ONLY because Row-Level Security
# is enabled on every table (supabase/migrations/0002_phase1_auth_and_schema.sql).
# Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# =============================================================================
# Razorpay
# =============================================================================
# READ THIS BEFORE PASTING ANY KEY.
#
# Razorpay gives you a Key ID (rzp_test_… / rzp_live_…) and a Key Secret.
# They do NOT go in the same place:
#
#   Key ID      -> publishable. Safe in the browser. Nothing below is needed,
#                  actually — the server returns it with each order so the app
#                  cannot charge into the wrong account. Left here only if you
#                  want to pin it for local experiments.
#
#   Key Secret  -> NEVER in this file, never in a VITE_ variable, never in the
#                  repo. It signs and verifies payments; anyone holding it can
#                  forge a receipt and grant themselves any plan.
#
# The secret lives ONLY in Supabase Edge Function secrets:
#
#   supabase secrets set RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#
# RAZORPAY_WEBHOOK_SECRET is a THIRD, separate value you choose when creating
# the webhook in the Razorpay dashboard. It is not the key secret.
#
# Full setup: docs/PAYMENTS.md
# -----------------------------------------------------------------------------

# Optional. The Key ID is published with each order by the server, so this is
# not required — leave it blank unless you have a specific reason.
VITE_RAZORPAY_KEY_ID=

# If you ever see VITE_RAZORPAY_KEY_SECRET anywhere, delete it and rotate the
# key in the Razorpay dashboard. Every VITE_ variable is compiled into the
# JavaScript bundle and is readable by anyone who opens devtools.
