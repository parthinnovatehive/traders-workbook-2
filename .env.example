# =============================================================================
# Trader's Workbook — environment variables
# Copy to `.env.local` and fill in. Only VITE_-prefixed vars reach the client.
# NEVER put service-role keys or secrets in a VITE_ variable — they are public.
# =============================================================================

# Data source for the app. "local" uses the in-browser mock repository
# (IndexedDB/localStorage) and needs no backend. "api" uses VITE_API_URL.
VITE_DATA_SOURCE=local

# Base URL of the real backend API (used only when VITE_DATA_SOURCE=api).
VITE_API_URL=

# --- Optional: Supabase backend (when wiring a real database) ---------------
# The anon key is safe to expose to the browser ONLY together with Row-Level
# Security policies enabled on every table. Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
