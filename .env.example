# =============================================================================
# Trader's Workbook — environment variables
# Copy to `.env.local` and fill in. Only VITE_-prefixed vars reach the client.
# NEVER put service-role keys or secrets in a VITE_ variable — they are public.
# =============================================================================

# Data source for the app.
#   "local"    — in-browser mock repository (localStorage). DEVELOPMENT ONLY:
#                it ships demo credentials and fake data, so a production build
#                refuses to start with it (see src/services/index.ts).
#   "supabase" — the real backend. Set the two variables below and run the
#                migrations in supabase/migrations/ in order (0001 → 0003).
VITE_DATA_SOURCE=local

# Base URL of an optional custom API (reserved for future use).
VITE_API_URL=

# --- Supabase backend (when VITE_DATA_SOURCE=supabase) -----------------------
# The anon key is safe to expose to the browser ONLY because Row-Level Security
# is enabled on every table (supabase/migrations/0002_phase1_auth_and_schema.sql).
# Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
